	cd /home/hzl/RAL_test/uav_gobal_path/Air-Ground-Coordination/Drone/build && $(MAKE) -f fitplane/CMakeFiles/Traversibility_mappings.dir/build.make fitplane/CMakeFiles/Traversibility_mappings.dir/src/plane.cpp.o
.PHONY : src/plane.cpp.o

src/plane.i: src/plane.cpp.i

.PHONY : src/plane.i

